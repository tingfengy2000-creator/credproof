* text=auto
*.md text eol=lf
*.mmd text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.png binary
# Preserve experiment exports byte-for-byte, including generated Markdown breaks.
experiments/results/** -text whitespace=-blank-at-eol,cr-at-eol
docs/review/evidence/** -text whitespace=-blank-at-eol,cr-at-eol
# Registered local-agent protocols and raw observations retain their exact bytes.
agent_pilot/protocol*.json -text whitespace=cr-at-eol
agent_pilot/isolation-tests/*.json -text whitespace=cr-at-eol
agent_pilot/isolation-tests/observations-*/** -text whitespace=cr-at-eol
experiments/local-agent-pilot/records/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/local-agent-pilot/reliability/** -text whitespace=-blank-at-eol,cr-at-eol
examples/local-agent/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/local-agent-pilot/source-snapshots/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/local-agent-pilot/tool-call-revision/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/preliminary-candidate/** -text whitespace=-blank-at-eol,cr-at-eol
docs/preliminary-candidate/materials/** -text whitespace=-blank-at-eol,cr-at-eol
