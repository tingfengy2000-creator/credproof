* text=auto
*.md text eol=lf
*.mmd text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.png binary
# Preserve experiment exports byte-for-byte, including generated Markdown breaks.
experiments/results/** -text whitespace=-blank-at-eol,cr-at-eol
docs/review/evidence/** -text whitespace=-blank-at-eol,cr-at-eol
# Registered local-agent protocols and raw observations retain their exact bytes.
agent_pilot/protocol*.json -text whitespace=cr-at-eol
agent_pilot/isolation-tests/*.json -text whitespace=cr-at-eol
agent_pilot/isolation-tests/observations-*/** -text whitespace=cr-at-eol
experiments/local-agent-pilot/records/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/local-agent-pilot/reliability/** -text whitespace=-blank-at-eol,cr-at-eol
examples/local-agent/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/local-agent-pilot/source-snapshots/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/local-agent-pilot/tool-call-revision/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/preliminary-candidate/** -text whitespace=-blank-at-eol,cr-at-eol
docs/preliminary-candidate/materials/** -text whitespace=-blank-at-eol,cr-at-eol
docs/preliminary-candidate/checks/** -text whitespace=-blank-at-eol,cr-at-eol
experiments/external-twine/** -text whitespace=-blank-at-eol,cr-at-eol
docs/external-scenario/** -text whitespace=-blank-at-eol,cr-at-eol
# Format-only public derivatives use the exact documented LF publication bytes.
docs/reusable-tool-safety/acceptance/20261010-format-normalized/public-evidence/** text eol=lf
# A unified diff's empty context line legitimately consists of one space.
docs/reusable-tool-safety/acceptance/20261010-format-normalized/public-evidence/normalization.diff whitespace=-blank-at-eol
# Linked-revision public records retain documented UTF-8 LF bytes.
docs/reusable-tool-safety/acceptance/20261010-feedback-revision/public-evidence/** text eol=lf whitespace=-blank-at-eol
docs/reusable-tool-safety/acceptance/20261010-feedback-revision/public-evidence/candidate.diff whitespace=-blank-at-eol,-blank-at-eof
# Human-review public project publication uses Git LF; historical workspace
# data is a disclosed exact-byte snapshot, not a checkout-normalized object.
docs/reusable-tool-safety/acceptance/20261010-human-review/public-evidence/** text eol=lf whitespace=-blank-at-eol
docs/reusable-tool-safety/acceptance/20261010-human-review/public-evidence/workspace/** -text whitespace=-blank-at-eol,cr-at-eol
docs/reusable-tool-safety/acceptance/20261010-human-review/public-evidence/**/*.jpg binary
docs/reusable-tool-safety/acceptance/20261010-human-review/public-evidence/**/*.whl binary
# PR1 review receipts publish exact UTF-8 LF bytes; the wheel stays binary.
docs/review/pr-1-tree-identity/evidence/** text eol=lf
docs/review/pr-1-tree-identity/evidence/**/*.whl binary
