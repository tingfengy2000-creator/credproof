# Candidate only: Docker-default denials plus explicit CredProof file access.
# Host-load validation is deferred to contract C; parsing is not enforcement.
abi <abi/4.0>,
#include <tunables/global>
profile credproof-bwrap flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  userns,
  network inet stream,
  network inet6 stream,
  network unix,
  # Needed only within bwrap's private user namespace, not container cap-add.
  capability sys_admin,
  capability setuid,
  capability setgid,
  / r,
  /usr/bin/python3{,.12} mrix,
  /usr/lib/** mr,
  /usr/share/** r,
  /lib{,64}/** mr,
  /opt/credproof/** mr,
  /opt/credproof/venv/bin/python{,3,3.12} mrix,
  /opt/credproof/venv/bin/credproof-safety rix,
  /opt/credproof-runtime/** mr,
  /opt/credproof-runtime/isolation/tools/usr/bin/bwrap mrix,
  /opt/credproof-runtime/isolation/rootfs/usr/bin/python3 mrix,
  /etc/{ld.so.cache,ld.so.conf,ld.so.conf.d/**,localtime,nsswitch.conf,hosts,host.conf,resolv.conf,gai.conf,passwd,group,os-release,lsb-release} r,
  /workspace/** r,
  /out/ rw,
  /out/** rwk,
  /tmp/ rw,
  /tmp/** rwk,
  /dev/{null,zero,random,urandom,tty} rw,
  /dev/fd/** r,
  /dev/shm/ rw,
  /dev/shm/** rwk,
  @{PROC}/** r,
  @{PROC}/{self,[0-9]*}/{uid_map,gid_map,setgroups} rw,
  /sys/** r,
  # Propagation only at /. Never allow binding the container root as rootfs.
  mount options=(rprivate) -> /,
  mount options=(rslave) -> /,
  mount options in (bind,rbind,ro,rw,remount,nosuid,nodev,noexec) /opt/credproof-runtime/** -> /tmp/**,
  mount options in (bind,rbind,ro,rw,remount,nosuid,nodev,noexec) /tmp/** -> /tmp/**,
  mount fstype=proc -> /{proc/,tmp/**},
  mount fstype=tmpfs -> /{dev/,dev/shm/,tmp/,tmp/**},
  mount fstype=devpts -> /{dev/pts/,tmp/**},
  remount options in (ro,rw,bind,remount,nosuid,nodev,noexec) /tmp/**,
  remount options in (ro,rw,bind,remount,nosuid,nodev,noexec) /dev/**,
  umount /tmp/**,
  umount /,
  pivot_root oldroot=/tmp/** /tmp/**,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=credproof-bwrap,
  deny network alg,
  deny network vsock,
  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
