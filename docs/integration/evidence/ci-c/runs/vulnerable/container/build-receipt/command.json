{
  "name": "build-receipt",
  "command": [
    "docker",
    "run",
    "--rm",
    "--network",
    "none",
    "--read-only",
    "--tmpfs",
    "/tmp:exec",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges",
    "-v",
    "<source>:/workspace:ro",
    "-v",
    "<source>/credproof-out/container:/out",
    "-v",
    "<runner-temp>/credproof-frozen-anchors:/anchors:ro",
    "--security-opt",
    "seccomp=<source>/deploy/docker/seccomp-credproof.json",
    "--security-opt",
    "systempaths=unconfined",
    "--security-opt",
    "apparmor=unconfined",
    "--entrypoint",
    "/opt/credproof/venv/bin/python",
    "credproof:ci",
    "-I",
    "-c",
    "import pathlib;print(pathlib.Path('/opt/credproof/build-receipt.json').read_text());print(pathlib.Path('/opt/credproof/source-commit.txt').read_text());import hashlib;print(hashlib.sha256(pathlib.Path('/opt/credproof-runtime/rootfs-manifest.json').read_bytes()).hexdigest())"
  ],
  "exit_code": 0,
  "expected_exit_codes": [
    0
  ],
  "matches": true,
  "duration_seconds": 0.226
}
